{
  "name": "terramoda/gestion-inventario",
  "type": "project",
  "description": "Plataforma de inventario y ventas por metraje para Terra Moda",
  "keywords": ["laravel", "inventario", "telas"],
  "license": "MIT",
  "require": {
    "php": "^8.2",
    "laravel/framework": "^11.0 || ^12.0",
    "laravel/tinker": "^2.9"
  },
  "require-dev": {
    "fakerphp/faker": "^1.23",
    "mockery/mockery": "^1.6",
    "nunomaduro/collision": "^8.1",
    "phpunit/phpunit": "^11.0"
  },
  "autoload": {"psr-4": {"App\\\\": "app/", "Database\\\\Factories\\\\": "database/factories/", "Database\\\\Seeders\\\\": "database/seeders/"}},
  "autoload-dev": {"psr-4": {"Tests\\\\": "tests/"}},
  "scripts": {
    "post-autoload-dump": ["@php artisan package:discover --ansi"],
    "post-create-project-cmd": ["@php artisan key:generate --ansi"]
  },
  "config": {"optimize-autoloader": true, "preferred-install": "dist", "sort-packages": true, "allow-plugins": {"php-http/discovery": true}},
  "minimum-stability": "stable",
  "prefer-stable": true
}
